// TOTEM — prosty layout QWERTY pod programowanie na Macu.
//
// Zasady:
//  - BASE = zwykłe QWERTY, żadnych mod-tapów na literach.
//  - Lewy środkowy kciuk (przytrzymaj) = NAV: strzałki + Ctrl/Opt/Cmd/Shift pod lewą ręką + kopiuj/wklej.
//  - Prawy środkowy kciuk (przytrzymaj) = SYM: cyfry, symbole, nawiasy.
//  - Oba środkowe kciuki naraz = ADJ: Bluetooth/USB, media, F-klawisze, bootloader.
//  - Esc = Q+W naraz (albo Q na warstwie NAV).
//
// Pozycje klawiszy (38): rząd 0 = 0-9, rząd 1 = 10-19, rząd 2 = 20-31 (20 i 31 to zewnętrzne pod małym palcem),
// kciuki = 32-37.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV SYM>;
            then-layer = <ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
//             ┌───────┬───────┬───────┬───────┬───────┐   ┌───────┬───────┬───────┬───────┬───────┐
//             │   Q   │   W   │   E   │   R   │   T   │   │   Y   │   U   │   I   │   O   │   P   │
//             ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
//             │   A   │   S   │   D   │   F   │   G   │   │   H   │   J   │   K   │   L   │   ;   │
//     ┌───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┐
//     │ SHIFT │   Z   │   X   │   C   │   V   │   B   │   │   N   │   M   │   ,   │   .   │   /   │  OPT  │
//     └───────┴───────┴───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┴───────┴───────┘
//                             │  CMD  │  NAV  │ SPACE │   │ ENTER │  SYM  │ BSPC  │
//                             └───────┴───────┴───────┘   └───────┴───────┴───────┘
            bindings = <
                &kp Q     &kp W     &kp E     &kp R     &kp T        &kp Y     &kp U     &kp I     &kp O     &kp P
                &kp A     &kp S     &kp D     &kp F     &kp G        &kp H     &kp J     &kp K     &kp L     &kp SEMI
      &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B        &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RALT
                                    &kp LGUI  &mo NAV   &kp SPACE    &kp RET   &mo SYM   &kp BSPC
            >;
        };

        nav_layer {
            display-name = "NAV";
//             ┌───────┬───────┬───────┬───────┬───────┐   ┌───────┬───────┬───────┬───────┬───────┐
//             │  ESC  │       │       │       │       │   │ LINE< │ PG DN │ PG UP │ LINE> │  DEL  │
//             ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
//             │ CTRL  │  OPT  │  CMD  │ SHIFT │  TAB  │   │   ←   │   ↓   │   ↑   │   →   │       │
//     ┌───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┐
//     │       │ UNDO  │  CUT  │ COPY  │ PASTE │ REDO  │   │       │       │       │       │       │       │
//     └───────┴───────┴───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┴───────┴───────┘
//                             │       │ (hold)│       │   │       │       │       │
//                             └───────┴───────┴───────┘   └───────┴───────┴───────┘
            bindings = <
                &kp ESC   &none     &none     &none     &none        &kp LG(LEFT) &kp PG_DN &kp PG_UP &kp LG(RIGHT) &kp DEL
                &kp LCTRL &kp LALT  &kp LGUI  &kp LSHFT &kp TAB      &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &none
      &trans    &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &kp LG(LS(Z)) &none    &none     &none     &none     &none     &trans
                                    &trans    &trans    &trans       &trans    &trans    &trans
            >;
        };

        sym_layer {
            display-name = "SYM";
//             ┌───────┬───────┬───────┬───────┬───────┐   ┌───────┬───────┬───────┬───────┬───────┐
//             │   1   │   2   │   3   │   4   │   5   │   │   6   │   7   │   8   │   9   │   0   │
//             ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
//             │   !   │   @   │   #   │   $   │   %   │   │   ^   │   &   │   *   │   (   │   )   │
//     ┌───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┐
//     │   `   │   ~   │   '   │   "   │   -   │   =   │   │   [   │   ]   │   {   │   }   │   \   │   |   │
//     └───────┴───────┴───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┴───────┴───────┘
//                             │       │       │       │   │       │ (hold)│       │
//                             └───────┴───────┴───────┘   └───────┴───────┴───────┘
//  _ = Shift + -     + = Shift + =     : = Shift + ;     < > ? = Shift + , . /
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5       &kp N6    &kp N7    &kp N8    &kp N9    &kp N0
                &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR
      &kp GRAVE &kp TILDE &kp SQT   &kp DQT   &kp MINUS &kp EQUAL    &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &kp BSLH  &kp PIPE
                                    &trans    &trans    &trans       &trans    &trans    &trans
            >;
        };

        adjust_layer {
            display-name = "ADJ";
//             ┌───────┬───────┬───────┬───────┬───────┐   ┌───────┬───────┬───────┬───────┬───────┐
//             │  BT 1 │  BT 2 │  BT 3 │BT CLR │       │   │ PREV  │ PLAY  │ NEXT  │ MUTE  │       │
//             ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
//             │  USB  │  BLE  │       │       │       │   │ VOL-  │ VOL+  │ BRI-  │ BRI+  │       │
//     ┌───────┼───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┼───────┐
//     │BOOTLDR│  F1   │  F2   │  F3   │  F4   │  F5   │   │  F6   │  F7   │  F8   │  F9   │  F10  │ RESET │
//     └───────┴───────┴───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┴───────┴───────┘
//                             │  F11  │ (hold)│  F12  │   │       │ (hold)│       │
//                             └───────┴───────┴───────┘   └───────┴───────┴───────┘
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &none    &kp C_PREV &kp C_PP  &kp C_NEXT &kp C_MUTE &none
                &out OUT_USB &out OUT_BLE &none     &none     &none        &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &none
      &bootloader &kp F1   &kp F2    &kp F3    &kp F4    &kp F5       &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &sys_reset
                                    &kp F11   &trans    &kp F12      &trans    &trans    &trans
            >;
        };
    };
};
