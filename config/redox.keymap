// REDOX — BASE jak najbliżej klawiatury Alice (najpierw przesiadka z Alice, potem ulepszenia).
// Warstwy: NAV (64) i ADJ/Fn (59). Bez SYM — jak na Alice.
//
// Zasady:
//  - BASE = jak Alice: rząd cyfr 1-5 | 6 (18) | 7 8 9 0 - = ⌫ (19, 6-11), BSPC prawy górny róg, ENTER i SHIFT pod
//    prawym małym palcem, spacja na szerokich klawiszach kciuków (60, 65), CMD na 61 i 59,
//    strzałki w odwróconym T w prawym dolnym rogu (54 ↑, 67 ←, 68 ↓, 69 →).
//  - NAV (przytrzymaj 64, prawy kciuk): strzałki na I J K L, Ctrl/Cmd/Shift pod lewą ręką,
//    wytnij/kopiuj/wklej na dolnym rzędzie, oraz znaki bez miejsca w BASE:
//    ` (0), \ (11), ] (25), ' (39), / (54).
//  - Option (Opt) tylko w BASE (57) — do polskich znaków na Macu.
//  - ADJ (Fn): przytrzymaj FN (66, pod przecinkiem). Bluetooth, media, F1-F12, BOOT: 40 = lewa połówka, 55 = prawa.
//
//  - Wyłączone: 46 47 48 49 62 63 (za daleko dla kciuka), 32 33 w BASE.
//
// Kolejność klawiszy w bindings (70): rząd cyfr 12, potem 14, 14, 16, 14.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define ADJ  2

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// Obrazek z numerami klawiszy: redox-layout.png (generowany z tego pliku).
            bindings = <
   &kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                                 &kp N8       &kp N9       &kp N0       &kp MINUS    &kp EQUAL    &kp BSPC
   &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T        &kp N6                    &kp N7       &kp Y        &kp U        &kp I        &kp O        &kp P        &kp LBKT
   &kp CAPS     &kp A        &kp S        &kp D        &kp F        &kp G        &none                     &none        &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp RET
   &kp LSHFT    &kp Z        &kp X        &kp C        &kp V        &kp B        &none        &none        &none        &none        &kp N        &kp M        &kp COMMA    &kp DOT      &kp UP       &kp RSHFT
   &kp LCTRL    &kp LALT     &none        &kp LGUI     &kp SPACE    &kp LGUI     &none        &none        &mo NAV      &kp SPACE    &mo ADJ      &kp LEFT     &kp DOWN     &kp RIGHT
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
   &kp GRAVE    &trans       &trans       &trans       &trans       &trans                                 &trans       &trans       &trans       &trans       &trans       &kp BSLH
   &trans       &kp ESC      &none        &none        &none        &none        &trans                    &trans       &trans       &trans       &kp UP       &trans       &kp DEL      &kp RBKT
   &trans       &kp LCTRL    &trans       &kp LGUI     &kp LSHFT    &kp TAB      &trans                    &trans       &trans       &kp LEFT     &kp DOWN     &kp RIGHT    &trans       &kp SQT
   &trans       &trans       &kp LG(X)    &kp LG(C)    &kp LG(V)    &trans       &none        &none        &none        &none        &none        &none        &none        &none        &kp FSLH     &trans
   &trans       &trans       &trans       &trans       &trans       &trans       &none        &none        &trans       &trans       &trans       &trans       &trans       &trans
            >;
        };


        adjust_layer {
            display-name = "ADJ";
            bindings = <
   &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                                 &kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
   &trans       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR   &none        &trans                    &trans       &kp C_PREV   &kp C_PP     &kp C_NEXT   &kp C_MUTE   &none        &trans
   &trans       &out OUT_USB &out OUT_BLE &none        &none        &none        &trans                    &trans       &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &none        &trans
   &bootloader  &trans       &trans       &trans       &trans       &trans       &none        &none        &none        &none        &trans       &trans       &trans       &trans       &trans       &bootloader
   &trans       &trans       &trans       &trans       &trans       &trans       &none        &none        &trans       &trans       &trans       &trans       &trans       &trans
            >;
        };
    };
};
