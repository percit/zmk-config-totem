// REDOX — BASE jak najbliżej klawiatury Alice (najpierw przesiadka z Alice, potem ulepszenia).
// Warstwy: NAV (65) i ADJ/Fn (59). Bez SYM — jak na Alice.
//
// Zasady:
//  - BASE = jak Alice: rząd cyfr, BSPC prawy górny róg, ENTER i SHIFT pod prawym małym palcem,
//    spacja pod oboma kciukami, strzałki tylko na NAV (I J K L). Rzadsze klawisze, na które Redox
//    nie ma miejsca: ` - ' na wewnętrznych kolumnach, = ] \ w prawym dolnym rogu (67 68 69).
//  - NAV (przytrzymaj 65, szeroki klawisz prawego kciuka): strzałki na I J K L, Ctrl/Cmd/Shift pod lewą ręką, wytnij/kopiuj/wklej na dolnym rzędzie.
//  - Option (Opt) tylko w BASE (57) — do polskich znaków na Macu.
//  - ADJ (Fn): przytrzymaj FN (59). Bluetooth, media, F1-F12, BOOT do wgrywania firmware: 40 = lewa połówka, 55 = prawa połówka.
//
//  - Wyłączone (&none na każdej warstwie): 46 47 48 49 62 63 — za daleko dla kciuka.
//
// Kolejność klawiszy w bindings (70): rząd cyfr 12, potem 14, 14, 16, 14.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define ADJ  2

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
// ┌─────┬─────┬─────┬─────┬─────┬─────┐                         ┌─────┬─────┬─────┬─────┬─────┬─────┐
// │ ESC │  1  │  2  │  3  │  4  │  5  │                         │  6  │  7  │  8  │  9  │  0  │BSPC │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┐             ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │ TAB │  Q  │  W  │  E  │  R  │  T  │  `  │             │  -  │  Y  │  U  │  I  │  O  │  P  │  [  │
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┤             ├─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │CAPS │  A  │  S  │  D  │  F  │  G  │ DEL │             │  '  │  H  │  J  │  K  │  L  │  ;  │ENTER│
// ├─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┐ ┌─────┼─────┼─────┼─────┼─────┼─────┼─────┼─────┤
// │SHIFT│  Z  │  X  │  C  │  V  │  B  │  -  │  -  │ │  -  │  -  │  N  │  M  │  ,  │  .  │  /  │SHIFT│
// ├─────┼─────┼─────┼─────┼─────┴─────┼─────┼─────┤ ├─────┼─────┼─────┴─────┼─────┼─────┼─────┼─────┤
// │CTRL │ OPT │  -  │ FN  │    CMD    │SPACE│  -  │ │  -  │SPACE│    NAV    │  -  │  =  │  ]  │  \  │
// └─────┴─────┴─────┴─────┴───────────┴─────┴─────┘ └─────┴─────┴───────────┴─────┴─────┴─────┴─────┘
            bindings = <
   &kp ESC      &kp N1       &kp N2       &kp N3       &kp N4       &kp N5                                 &kp N6       &kp N7       &kp N8       &kp N9       &kp N0       &kp BSPC
   &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T        &kp GRAVE                 &kp MINUS    &kp Y        &kp U        &kp I        &kp O        &kp P        &kp LBKT
   &kp CAPS     &kp A        &kp S        &kp D        &kp F        &kp G        &kp DEL                   &kp SQT      &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp RET
   &kp LSHFT    &kp Z        &kp X        &kp C        &kp V        &kp B        &none        &none        &none        &none        &kp N        &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT
   &kp LCTRL    &kp LALT     &none        &mo ADJ      &kp LGUI     &kp SPACE    &none        &none        &kp SPACE    &mo NAV      &none        &kp EQUAL    &kp RBKT     &kp BSLH
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
   &trans       &trans       &trans       &trans       &trans       &trans                                 &trans       &trans       &trans       &trans       &trans       &trans
   &trans       &kp ESC      &none        &none        &none        &none        &trans                    &trans       &trans       &trans       &kp UP       &trans       &kp DEL      &trans
   &trans       &kp LCTRL    &trans       &kp LGUI     &kp LSHFT    &kp TAB      &trans                    &trans       &trans       &kp LEFT     &kp DOWN     &kp RIGHT    &trans       &trans
   &trans       &trans       &kp LG(X)    &kp LG(C)    &kp LG(V)    &trans       &none        &none        &none        &none        &none        &none        &none        &none        &none        &trans
   &trans       &trans       &trans       &trans       &trans       &trans       &none        &none        &trans       &trans       &trans       &trans       &trans       &trans
            >;
        };


        adjust_layer {
            display-name = "ADJ";
            bindings = <
   &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                                 &kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12
   &trans       &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR   &none        &trans                    &trans       &kp C_PREV   &kp C_PP     &kp C_NEXT   &kp C_MUTE   &none        &trans
   &trans       &out OUT_USB &out OUT_BLE &none        &none        &none        &trans                    &trans       &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP &none        &trans
   &bootloader  &trans       &trans       &trans       &trans       &trans       &none        &none        &none        &none        &trans       &trans       &trans       &trans       &trans       &bootloader
   &trans       &trans       &trans       &trans       &trans       &trans       &none        &none        &trans       &trans       &trans       &trans       &trans       &trans
            >;
        };
    };
};
